{
  "expo": {
    "name": "vision360",
    "slug": "vision360",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-1024.png",
    "scheme": "vision360",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a",
        "foregroundImage": "./assets/images/android-icon-foreground-vision360.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vision360"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-vision360.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e1a",
          "image": "./assets/images/splash-vision360.png",
          "imageWidth": 220
        }
      ],
      "expo-video",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a Visión360 usar la cámara para la videovigilancia",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir a Visión360 acceder a tus fotos para guardar las capturas",
          "savePhotosPermission": "Permitir a Visión360 guardar las capturas de la cámara",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1fbdbf10-9d1c-4213-85c0-cacd0f85770c"
      }
    }
  }
}
